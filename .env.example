# Google OAuth Client Credentials (for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=

# Cashfree Payment Gateway Credentials
# Mode: SANDBOX for test transactions, PRODUCTION for live payments
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# Postmark Transactional Email Delivery
# Obtain Server API Token from your Postmark Server settings
