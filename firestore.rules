rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // System diagnostic collection
    match /system_health/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['status', 'timestamp']);
    }

    // Public catalog and config (read-only for clients)
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'productId', 'name', 'rating', 'comment', 'createdAt'])
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // Orders collection: Patrons can submit new verified orders
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'items', 'total', 'status', 'contact', 'createdAt'])
                    && request.resource.data.status in ['Confirmed', 'Processing', 'Delivered', 'Cancelled'];
      allow read: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Customer accounts
    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'email', 'createdAt']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'savedAddresses', 'updatedAt', 'hash', 'salt']);
      allow delete: if false;
    }
  }
}

